<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>59.0</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Account Notification Body</masterLabel>

  <targets>
    <target>lightning__AppPage</target>
    <target>lightning__RecordPage</target>
    <target>lightning__HomePage</target>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>

  <targetConfigs>
    <!-- Make properties editable in Experience Builder -->
    <targetConfig targets="lightningCommunity__Default">
      <property name="customerNumber" type="String" label="Customer Number"/>
      <property name="accountNumber" type="String" label="Account Number"/>
      <property name="openedDate" type="String" label="Opened Date"/>
      <property name="fundingStatus" type="String" label="Funding Status"/>
      <property name="cardImageUrl" type="String" label="Card Image URL"/>
    </targetConfig>

    <!-- App Builder version (optional) -->
    <targetConfig targets="lightning__AppPage">
      <property name="customerNumber" type="String" label="Customer Number"/>
      <property name="accountNumber" type="String" label="Account Number"/>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>
