<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Account Contact Update</masterLabel>
    <isExposed>true</isExposed>
    <description>Updates Account dashboard when Contacts change</description>
    
    <!-- Optional: Define payload fields for autocomplete -->
    <lightningMessageFields>
        <fieldName>accountId</fieldName>
        <description>Account Record Id</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>action</fieldName>
        <description>contact_added, contact_deleted, refresh</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>newTotal</fieldName>
        <description>New contact count</description>
    </lightningMessageFields>
</LightningMessageChannel>
